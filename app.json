{
  "expo": {
    "name": "Split Bill By KepoX",
    "slug": "SplitBillApp",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/LOGO.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070A10",
        "foregroundImage": "./assets/LOGO.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.SplitBillApp"
    },
    "web": {
      "favicon": "./assets/LOGO.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi perlu akses galeri untuk memilih foto struk.",
          "cameraPermission": "Aplikasi perlu akses kamera untuk memotret struk belanja."
        }
      ],
      "expo-splash-screen",
      [
        "react-native-share",
        {
          "enableBase64ShareAndroid": false
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "20466dcc-2296-4b56-a5ad-04f88c034647"
      }
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/20466dcc-2296-4b56-a5ad-04f88c034647"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "kepoxx"
  }
}
