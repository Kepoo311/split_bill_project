{"nodes": [{"id": "split_bill_by_kepox", "label": "Split Bill By KepoX", "file_type": "concept", "source_file": "README.md", "source_location": "line 4-5", "source_url": "https://github.com/Kepoo311/split_bill_project", "captured_at": null, "author": null, "contributor": "Kepoo311", "rationale": "Mobile app for groups to scan receipts, split bills, and manage shared-payment history without sending receipt photos or bill data to a cloud OCR service."}, {"id": "local_first_architecture", "label": "Local-First Architecture", "file_type": "concept", "source_file": "README.md", "source_location": "line 17, 110-113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design intent: privacy. OCR runs on-device and history/settings stay in app-local storage so receipt data never leaves the phone. Trade-off accepted: no cloud sync or backup, and uninstalling the app loses all data."}, {"id": "ocr_pipeline", "label": "On-Device OCR Pipeline", "file_type": "concept", "source_file": "README.md", "source_location": "line 24-25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two stages: ML Kit extracts raw text, then layout-aware parsing groups text by line and detects item/price candidates before user review."}, {"id": "mlkit_text_recognition", "label": "Google ML Kit Text Recognition", "file_type": "concept", "source_file": "README.md", "source_location": "line 24, 37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over cloud OCR providers so recognition happens entirely on-device. Package: @react-native-ml-kit/text-recognition."}, {"id": "receipt_layout_parsing", "label": "Receipt Line-Layout Parsing", "file_type": "concept", "source_file": "README.md", "source_location": "line 25, 112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heuristic, not model-based: groups OCR text by line layout and detects item/price candidates. Accuracy varies per receipt, so results are treated as suggestions requiring review."}, {"id": "ocr_review_and_edit", "label": "Manual OCR Review and Edit", "file_type": "concept", "source_file": "README.md", "source_location": "line 26, 19, 112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Human-in-the-loop step compensates for heuristic parsing limits; app is in development and OCR results must be checked before saving or sharing."}, {"id": "member_assignment", "label": "Member Assignment to Items", "file_type": "concept", "source_file": "README.md", "source_location": "line 27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Items can be assigned to one or several people, supporting shared dishes rather than a flat per-head split."}, {"id": "proportional_split_calculation", "label": "Proportional Tax/Service/Discount Split", "file_type": "concept", "source_file": "README.md", "source_location": "line 28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tax, service charge, and discount are distributed proportionally to each person's subtotal so totals stay fair and sum to the receipt total."}, {"id": "bill_history_persistence", "label": "Bill History Persistence", "file_type": "concept", "source_file": "README.md", "source_location": "line 29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores bill history plus payment status, category, payment method, and OCR correction data locally, so past corrections remain inspectable."}, {"id": "share_bill_summary", "label": "Share Bill Summary", "file_type": "concept", "source_file": "README.md", "source_location": "line 30, 111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shares via the device share sheet to a user-chosen target app, keeping the app free of any server-side distribution channel."}, {"id": "qris_qr_image", "label": "QRIS Payment QR Image", "file_type": "concept", "source_file": "README.md", "source_location": "line 30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional QRIS image can be attached to the shared bill so payers can scan directly."}, {"id": "custom_modal_ui", "label": "Custom Modal UI", "file_type": "concept", "source_file": "README.md", "source_location": "line 31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App interface uses custom modals instead of platform dialogs for consistent cross-platform presentation."}, {"id": "asyncstorage", "label": "AsyncStorage Local Persistence", "file_type": "concept", "source_file": "README.md", "source_location": "line 38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Key-value local storage chosen as the only persistence layer, reinforcing local-first with no database or backend."}, {"id": "zustand_state", "label": "Zustand State Management", "file_type": "concept", "source_file": "README.md", "source_location": "line 39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "typescript", "label": "TypeScript", "file_type": "concept", "source_file": "README.md", "source_location": "line 36, 62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "react_navigation", "label": "React Navigation", "file_type": "concept", "source_file": "README.md", "source_location": "line 40, 59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "README documents React Navigation with a src/navigation/ folder and App.js entry, which conflicts with AGENTS.md mandating Expo Router under src/app/. Likely stale README \u2014 flag for review."}, {"id": "expo_image_picker", "label": "Expo Imag